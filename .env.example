# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# HuggingFace token — required to download ibm-granite/granite-speech-4.0-1b.
# Get one at https://huggingface.co/settings/tokens (read access is enough).
# Accept the model licence at https://huggingface.co/ibm-granite/granite-speech-4.0-1b first.
HF_TOKEN=hf_your_token_here
